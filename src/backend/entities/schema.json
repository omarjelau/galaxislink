  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profile information.  User ID is the Firebase Authentication UID.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user, matching the Firebase Auth UID."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/linkPages/{linkPageId}",
        "definition": {
          "entityName": "LinkPage",
          "schema": {
            "$ref": "#/backend/entities/LinkPage"
          },
          "description": "Stores Linktree-like pages created by the user. Includes denormalized 'userId' field for authorization independence.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user who owns the link page."
            },
            {
              "name": "linkPageId",
              "description": "The unique identifier for the link page."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/linkPages/{linkPageId}/links/{linkId}",
        "definition": {
          "entityName": "Link",
          "schema": {
            "$ref": "#/backend/entities/Link"
          },
          "description": "Stores individual links within a link page. Includes denormalized 'linkPageId' and 'userId' for authorization independence.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user who owns the link page."
            },
            {
              "name": "linkPageId",
              "description": "The unique identifier for the link page containing the link."
            },
            {
              "name": "linkId",
              "description": "The unique identifier for the link."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/businessCards/{businessCardId}",
        "definition": {
          "entityName": "BusinessCard",
          "schema": {
            "$ref": "#/backend/entities/BusinessCard"
          },
          "description": "Stores digital business cards created by the user. Includes denormalized 'userId' field for authorization independence.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user who owns the business card."
            },
            {
              "name": "businessCardId",
              "description": "The unique identifier for the business card."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/businessCards/{businessCardId}/socialLinks/{socialLinkId}",
        "definition": {
          "entityName": "SocialLink",
          "schema": {
            "$ref": "#/backend/entities/SocialLink"
          },
          "description": "Stores social media links associated with a business card.  Includes denormalized 'businessCardId' and 'userId' for authorization independence.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user who owns the business card."
            },
            {
              "name": "businessCardId",
              "description": "The unique identifier for the business card."
            },
            {
              "name": "socialLinkId",
              "description": "The unique identifier for the social link."
            }
          ]
        }
      },
       {
        "path": "/analytics/{userId}/linkPages/{pageId}",
        "definition": {
          "entityName": "AnalyticsLinkPage",
          "schema": {
            "$ref": "#/backend/entities/AnalyticsLinkPage"
          },
          "description": "Stores aggregated analytics data for a user's link pages."
        }
      },
      {
        "path": "/analytics/{userId}/businessCards/{cardId}",
        "definition": {
          "entityName": "AnalyticsBusinessCard",
          "schema": {
            "$ref": "#/backend/entities/AnalyticsBusinessCard"
          },
          "description": "Stores aggregated analytics data for a user's business cards."
        }
      }
    ],
    "reasoning": "The Firestore structure is designed to support the VibeLink platform, combining features of Linktree and Vibecard.de. It prioritizes authorization independence, clarity, and scalability.  \n\nAuthorization Independence: Achieved through path-based ownership for user-specific data (LinkPages, BusinessCards, and Links). This eliminates the need for `get()` calls in security rules, allowing for atomic operations.\n\nStructural Segregation: Each collection serves a specific purpose and has a homogeneous security posture. User-owned data is separated from other data, simplifying security rules. A new top-level `analytics` collection is introduced to store aggregated analytics data, separating it from primary user data for performance and clarity.\n\nAccess Modeling: Path-based ownership is used for private user data.  This approach is efficient for managing data associated with individual users.\n\nQAPs Support:\n\n*   Secure List Operations: Path-based ownership ensures users can only list LinkPages, BusinessCards, and Links associated with their own user ID. There are no global roles, which also aids in QAPs support.\n\n*   Membership Models: Not explicitly used in this version since the application is focused on individual user content. If collaboration were added, the 'members' map would be utilized.\n\nDenormalization Strategy: The `userId` is duplicated within the LinkPage and BusinessCard documents. The `linkPageId` is duplicated within Link documents. This ensures that access control can be enforced based on the document content itself, without needing to traverse the document hierarchy. This ensures authorization independence."
  }
}
