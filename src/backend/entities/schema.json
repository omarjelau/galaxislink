
{
  "backend": {
    "projectId": "vibecard-dev",
    "location": "europe-west3"
  },
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user profile in the system.",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique identifier for the user (Firebase UID)."
        },
        "username": {
          "type": "string",
          "description": "The user's chosen username."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "bio": {
          "type": "object",
          "description": "A short biography of the user.",
          "properties": {
            "de": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          }
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL of the user's avatar image.",
          "format": "uri"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp indicating when the user profile was created.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "username",
        "displayName",
        "email"
      ]
    },
    "LinkPage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LinkPage",
      "type": "object",
      "description": "Represents a link page, similar to a Linktree page, containing a collection of links.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": {
          "type": "object",
          "properties": { "de": { "type": "string" }, "en": { "type": "string" } }
        },
        "theme": { "type": "string" },
        "fontStyle": {
          "type": "string",
          "enum": ["modern", "elegant", "playful"]
        },
        "buttonStyle": {
          "type": "string",
          "enum": ["rounded", "full", "sharp"]
        },
        "buttonShadow": { "type": "boolean" },
        "iconsPerRow": { "type": "number" },
        "iconSize": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "title"
      ]
    },
