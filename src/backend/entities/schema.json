    "BusinessCard": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "BusinessCard",
      "type": "object",
      "description": "Represents a digital business card created by a user.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "pronouns": { "type": "string" },
        "jobTitle": {
          "type": "object",
          "properties": { "de": { "type": "string" }, "en": { "type": "string" } }
        },
        "bio": {
          "type": "object",
          "properties": { "de": { "type": "string" }, "en": { "type": "string" } }
        },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "coverPhotoUrl": { "type": "string", "format": "uri" },
        "companyLogoUrl": { "type": "string", "format": "uri" },
        "qrCode": { "type": "string" },
        "nfcUrl": { "type": "string" },
        "socials": {
            "type": "array",
            "items": { "$ref": "#/backend/entities/SocialLink" }
        }
      },
      "required": [
