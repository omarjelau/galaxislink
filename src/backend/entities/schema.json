        "name"
      ]
    },
    "SocialLink": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SocialLink",
      "type": "object",
      "description": "Represents a social media link associated with a BusinessCard.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the social link."
        },
        "businessCardId": {
          "type": "string",
          "description": "Reference to BusinessCard. (Relationship: BusinessCard 1:N SocialLink)"
        },
        "platform": {
          "type": "string",
          "description": "Name of the social media platform (e.g., Facebook, Twitter, LinkedIn)."
        },
        "url": {
          "type": "string",
          "description": "URL to the user's profile on the social media platform.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "businessCardId",
        "platform",
        "url"
      ]
    },
    "AnalyticsLinkPage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AnalyticsLinkPage",
      "type": "object",
      "description": "Stores analytics data for a specific link page.",
      "properties": {
        "totalClicks": { "type": "number" },
        "clicksByLink": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "clicks": { "type": "number" },
              "lastClicked": { "type": "string", "format": "date-time" }
            }
          }
        },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "AnalyticsBusinessCard": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AnalyticsBusinessCard",
      "type": "object",
      "description": "Stores analytics data for a specific business card.",
      "properties": {
        "totalScans": { "type": "number" },
        "lastScanned": { "type": "string", "format": "date-time" }
      }
    }
